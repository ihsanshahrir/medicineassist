# Copy to .dev.vars (gitignored) and fill in for local development.
# `wrangler dev` / `vite dev` (via adapter-cloudflare) read this automatically —
# no need to declare these in wrangler.jsonc, and they're never committed.
#
# Generate a real local SESSION_SECRET with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"

SESSION_SECRET=replace-with-a-long-random-string

# Optional for local dev — if unset, OTP codes are logged to the terminal
# instead of emailed (see src/lib/server/email.ts). Only needed to actually
# test real email delivery. SENDGRID_FROM_EMAIL must be a Single Sender
# verified in SendGrid's dashboard (no domain/DNS needed for that).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# For M4's reminder pipeline — only the public half goes here (handed to the
# browser to subscribe with, via GET /api/push/public-key). The matching
# private key goes in workers/reminder-engine/.dev.vars instead, never here.
# Generate both with: node scripts/generate-vapid-keys.mjs
VAPID_PUBLIC_KEY=
