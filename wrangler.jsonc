{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Main web app: all HTTP routes (src/routes/**) + Queue producer.
	// The cron scan + queue consumer live in a separate worker — see
	// workers/reminder-engine/wrangler.jsonc — because adapter-cloudflare's
	// generated worker only exports `fetch`, not `scheduled`/`queue`.
	"name": "medsassist-web",
	"compatibility_date": "2026-08-16",
	"compatibility_flags": ["nodejs_als", "nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,

	// PLACEHOLDER IDs below — replace after running (once, with your own
	// Cloudflare login): see db/README.md for the exact provisioning commands.
	// `wrangler dev` runs D1/KV/Queues against local Miniflare emulation
	// regardless of these IDs, so local development works before you provision
	// anything real. Only `wrangler deploy` needs the real IDs filled in.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "medsassist",
			"database_id": "f59bc249-dc1c-4f82-b3f0-feab5b1b7bfd",
			"migrations_dir": "db/migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "OTP_KV",
			"id": "495e414f6e674c72ac4a0b60970531c3"
		},
		{
			// Photo storage (label/pill photos). KV instead of R2 — no account-level
			// dashboard enablement needed, and well within KV's free tier for a
			// handful of users. See src/lib/server/photos.ts.
			"binding": "PHOTOS",
			"id": "e06c53dbdd814c9196abb989ae74d491"
		}
	],
	// Workers AI has no local emulation — unlike D1/KV/Queues above, every
	// AI call proxies to Cloudflare's real edge inference even under
	// `wrangler dev`/`vite dev`, which needs either `wrangler login` or a
	// CLOUDFLARE_API_TOKEN env var. That requirement used to block the ENTIRE
	// platform proxy session if this binding was present at all (confirmed by
	// testing pre-M3), so it stayed commented out until the OCR endpoint
	// (M3) existed to use it. Run `wrangler login` once before `vite dev` if
	// local dev now fails to start — see db/README.md.
	"ai": { "binding": "AI" },
	"queues": {
		"producers": [
			{
				"binding": "NOTIFY_QUEUE",
				"queue": "medsassist-notifications"
			}
		]
	}
}
